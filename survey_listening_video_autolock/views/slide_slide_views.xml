<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_slide_slide_form_listening_video" model="ir.ui.view">
            <field name="name">slide.slide.form.listening.video</field>
            <field name="model">slide.slide</field>
            <field name="inherit_id" ref="website_slides.view_slide_slide_form"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='description']" position="after">
                    <group string="Listening Test Audio/Video">
                        <field name="listening_video_type" widget="radio"/>

                        <field name="listening_video_url"
                               placeholder="https://example.com/video.mp4"
                               invisible="listening_video_type != 'url'"/>

                        <field name="listening_video_file"
                               filename="listening_video_filename"
                               invisible="listening_video_type != 'upload'"/>

                        <field name="listening_video_filename" invisible="1"/>

                        <div class="text-muted">
                            The audio/video appears inside the content description,
                            starts only after clicking Start, cannot be skipped,
                            and locks when finished.
                        </div>
                    </group>
                </xpath>

            </field>
        </record>
    </data>
</odoo>