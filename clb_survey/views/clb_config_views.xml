<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_clb_config_form" model="ir.ui.view">
        <field name="name">clb.level.config.form</field>
        <field name="model">clb.level.config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="skill_type"/>
                        <field name="clb_level"/>
                        <field name="min_percentage"/>
                        <field name="max_percentage"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_clb_config_tree" model="ir.ui.view">
        <field name="name">clb.level.config.list</field>
        <field name="model">clb.level.config</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="skill_type"/>
                <field name="clb_level"/>
                <field name="min_percentage"/>
                <field name="max_percentage"/>
            </list>
        </field>
    </record>

    <record id="action_clb_config" model="ir.actions.act_window">
        <field name="name">CLB Level Thresholds</field>
        <field name="res_model">clb.level.config</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Placed under the Survey top-level app menu -->
    <menuitem id="menu_clb_config"
              name="CLB Levels"
              parent="survey.menu_surveys"
              action="action_clb_config"
              sequence="50"
              groups="base.group_system"/>
</odoo>
