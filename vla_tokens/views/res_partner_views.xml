<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_vla_tokens" model="ir.ui.view">
        <field name="name">res.partner.form.vla.tokens</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="VLA Token Wallet">
                    <group>
                        <group>
                            <field name="vla_token_30_count" readonly="1"/>
                            <field name="vla_token_60_count" readonly="1"/>
                            <field name="vla_token_total_count" readonly="1"/>
                        </group>
                        <group>
                            <button string="Resync Tokens" type="object" name="action_vla_resync_tokens" class="btn-secondary"/>
                        </group>
                    </group>
                    <group string="Wallet Balances">
                        <field name="vla_token_wallet_line_ids" readonly="1">
                            <list create="0" delete="0" edit="0">
                                <field name="duration"/>
                                <field name="balance"/>
                            </list>
                        </field>
                    </group>
                    <group string="B2C Assessment URLs">
                        <field name="vla_assessment_token_ids" readonly="1">
                            <list create="0" delete="0" edit="0">
                                <field name="name"/>
                                <field name="token_type"/>
                                <field name="duration"/>
                                <field name="state"/>
                                <field name="registration_url"/>
                                <field name="product_id"/>
                                <field name="sale_order_id"/>
                            </list>
                        </field>
                    </group>
                    <group string="Ledger">
                        <field name="vla_token_transaction_ids" readonly="1">
                            <list create="0" delete="0" edit="0">
                                <field name="create_date"/>
                                <field name="duration"/>
                                <field name="amount"/>
                                <field name="balance_after"/>
                                <field name="reason"/>
                                <field name="product_id"/>
                                <field name="invoice_id"/>
                                <field name="note"/>
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
