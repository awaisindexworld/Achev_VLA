<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_elearning_detail" model="ir.module.category">
        <field name="name">eLearning Detail</field>
        <field name="sequence">25</field>
    </record>

    <record id="group_elearning_detail_user" model="res.groups">
        <field name="name">eLearning Detail User</field>
        <field name="category_id" ref="elearning_details.module_category_elearning_detail"/>
        <!-- Allows this custom group to see the eLearning configuration menu in Odoo 18. -->
        <field name="implied_ids" eval="[(4, ref('website_slides.group_website_slides_officer'))]"/>
    </record>
</odoo>
