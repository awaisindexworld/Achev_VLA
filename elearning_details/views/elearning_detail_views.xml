<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_elearning_detail_tree" model="ir.ui.view">
        <field name="name">elearning.detail.tree</field>
        <field name="model">elearning.detail</field>
        <field name="arch" type="xml">
            <list string="Details">
                <field name="name"/>
                <field name="skill_type"/>
                <field name="job_position_id"
                       string="Job Position"
                       optional="show"
                       domain="[('company_id', 'in', context.get('allowed_company_ids', []))]"/>
            </list>
        </field>
    </record>

    <record id="view_elearning_detail_form" model="ir.ui.view">
        <field name="name">elearning.detail.form</field>
        <field name="model">elearning.detail</field>
        <field name="arch" type="xml">
            <form string="Details">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="skill_type" widget="radio" options="{'horizontal': true}"/>
                    </group>

                    <!-- Only for All Skills -->
                    <group string="All Skills Recommendation" invisible="skill_type != 'all_skills'">
                        <field name="job_position_id"
                               string="Job Position"
                               domain="[('company_id', 'in', context.get('allowed_company_ids', []))]"
                               options="{'no_create': True, 'no_open': False}"
                               help="Only job positions from the checked companies will be available here."/>

                        <field name="recommendation"
                               nolabel="1"
                               widget="html"
                               placeholder="Write the recommendation for this job position here."/>
                    </group>

                    <!-- Only for Speaking / Listening / Writing / Reading -->
                    <notebook invisible="skill_type == 'all_skills'">
                        <page string="Lines">
                            <field name="line_ids"
                                   context="{'default_detail_id': id}">

                                <list string="Lines">
                                    <field name="sequence" widget="handle"/>
                                    <field name="clb"/>

                                    <field name="job_position_id"
                                           string="Job Position"
                                           domain="[('company_id', 'in', context.get('allowed_company_ids', []))]"
                                           options="{'no_create': True, 'no_open': False}"/>

                                    <field name="can_do_statement" string="Can do statement"/>
                                    <field name="recommendation"/>
                                </list>

                                <form string="Detail Line">
                                    <sheet>
                                        <group>
                                            <field name="clb"/>

                                            <field name="job_position_id"
                                                   string="Job Position"
                                                   domain="[('company_id', 'in', context.get('allowed_company_ids', []))]"
                                                   options="{'no_create': True, 'no_open': False}"
                                                   help="Leave empty for the generic/default line. Select a job position to create a customised version for that position."/>
                                        </group>

                                        <separator string="Can do statement"/>

                                        <field name="can_do_statement"
                                               nolabel="1"
                                               widget="html"/>

                                        <separator string="Recommendation"/>

                                        <field name="recommendation"
                                               nolabel="1"
                                               widget="html"/>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_elearning_detail_line_tree" model="ir.ui.view">
        <field name="name">elearning.detail.line.tree</field>
        <field name="model">elearning.detail.line</field>
        <field name="arch" type="xml">
            <list string="Detail Lines">
                <field name="sequence" widget="handle"/>
                <field name="detail_id"/>
                <field name="clb"/>

                <field name="job_position_id"
                       string="Job Position"
                       domain="[('company_id', 'in', context.get('allowed_company_ids', []))]"
                       options="{'no_create': True, 'no_open': False}"/>

                <field name="can_do_statement" string="Can do statement"/>
                <field name="recommendation"/>
            </list>
        </field>
    </record>

    <record id="view_elearning_detail_line_form" model="ir.ui.view">
        <field name="name">elearning.detail.line.form</field>
        <field name="model">elearning.detail.line</field>
        <field name="arch" type="xml">
            <form string="Detail Line">
                <sheet>
                    <group>
                        <field name="detail_id" invisible="1"/>
                        <field name="clb"/>

                        <field name="job_position_id"
                               string="Job Position"
                               domain="[('company_id', 'in', context.get('allowed_company_ids', []))]"
                               options="{'no_create': True, 'no_open': False}"
                               help="Leave empty for the generic/default line. Select a job position to create a customised version for that position."/>
                    </group>

                    <group string="Can do statement">
                        <field name="can_do_statement"
                               nolabel="1"
                               widget="html"
                               placeholder="Write the can-do statement here. You can use bullets, bold text, and formatting."/>
                    </group>

                    <group string="Recommendation">
                        <field name="recommendation"
                               nolabel="1"
                               widget="html"
                               placeholder="Write the recommendation for this CLB/job position here."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_elearning_detail" model="ir.actions.act_window">
        <field name="name">Details</field>
        <field name="res_model">elearning.detail</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
            id="menu_elearning_detail"
            name="Details"
            parent="website_slides.website_slides_menu_configuration"
            action="action_elearning_detail"
            sequence="20"
            groups="elearning_details.group_elearning_detail_user"
    />

</odoo>
